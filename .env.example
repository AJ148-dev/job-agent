TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# "gemini" (Google API, free tier available) or "ollama" (local model, heavy on the laptop)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional backup used when Gemini fails or hits its free limit (key: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional overrides
# DATA_DIR=data
# PROFILE_PATH=profile.yaml
# MAX_POSTS_PER_RUN=60
